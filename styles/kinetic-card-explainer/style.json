{
 "name": "kinetic-card-explainer",
 "description": "Vertical explainer built from one-idea scenes. Hard cuts about every 1.4 s between flat dark, light, beige and terracotta scenes that hold a small diagram, a pixel mascot, pills and arrows that spring in, one or two bold sans words at a time with an italic serif accent word in sky blue, two talking-head cut-ins with serif italic captions, and a closing comment KEYWORD end card that dims for the last four seconds. Voice only, no music bed.",
 "defaults": {
  "aspect": "9:16",
  "duration": 31.0
 },
 "structure": {
  "intro_beats": 3,
  "outro_beats": 3,
  "drop_at": 0.5,
  "drop_beats": 4,
  "end_on_bar": false,
  "vo_start_beats": 0.25
 },
 "cuts": {
  "first_shot_beats": 3,
  "min_beats": 2,
  "phrase_snap_beats": 1.0,
  "bar_align": false,
  "lengths": {
   "default": [
    [
     3,
     5
    ],
    [
     2,
     3
    ],
    [
     4,
     2
    ]
   ]
  },
  "snap_words": {
   "tol": 0.3,
   "min_len": 0.8
  }
 },
 "clips": {
  "select": "sequential",
  "avoid_repeat": 1,
  "jitter": 0.1
 },
